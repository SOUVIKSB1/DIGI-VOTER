[Unit]
Description=VoteVision AI Gunicorn Daemon
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/var/www/DIGI-VOTER/Backend
Environment="PATH=/var/www/DIGI-VOTER/.venv/bin:/usr/local/bin:/usr/bin"
Environment="FLASK_ENV=production"
Environment="PORT=5001"
ExecStart=/var/www/DIGI-VOTER/.venv/bin/gunicorn \
          --workers 3 \
          --threads 4 \
          --bind 127.0.0.1:5001 \
          --timeout 120 \
          --access-logfile /var/log/votevision/access.log \
          --error-logfile /var/log/votevision/error.log \
          "app:create_app('production')"

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
